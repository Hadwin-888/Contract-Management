generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(uuid())
  username       String   @unique
  passwordHash   String   @map("password_hash")
  name           String
  email          String?
  department     String?
  departmentCode String?  @map("department_code")
  role           String   @default("clerk")
  avatar         String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  contracts           Contract[]
  auditRecords        AuditRecord[]
  auditTemplates      AuditTemplate[]
  notifications       Notification[]
  notificationPrefs   NotificationPreference[]
  taskComments        TaskComment[]
  taskChangeLogs      TaskChangeLog[]
  projectMembers      ProjectMember[]
  ownedProjects       Project[] @relation("ProjectOwner")
  projectFiles        ProjectFile[]
  taskFiles           TaskFile[]
  progressUpdates     ProgressUpdate[]
  procurementRequests ProcurementRequest[]
  assetChangeRequests AssetChangeRequest[]
  assetPurchaseRequests AssetPurchaseRequest[]
  approvalRecords     ApprovalRecord[]
  userRoles           UserRole[]
  tasks               Task[]

  @@map("users")
}

model Department {
  id        String   @id @default(uuid())
  code      String   @unique
  shortName String   @map("short_name")
  name      String
  headName  String   @default("") @map("head_name")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("departments")
}

model Contract {
  id                 String   @id @default(uuid())
  name               String
  partyA             String   @map("party_a")
  partyB             String   @map("party_b")
  type               String
  status             String   @default("draft")
  amount             Float    @default(0)
  amountExcludingTax Float?   @map("amount_excluding_tax")
  taxRate            Float?   @map("tax_rate")
  qualityDeposit     String?  @map("quality_deposit")
  contractNo         String?  @map("contract_no")
  startDate          String   @map("start_date")
  endDate            String   @map("end_date")
  contractTerm       String?  @map("contract_term")
  riskLevel          String   @default("low") @map("risk_level")
  insuranceInfo      String?  @map("insurance_info")
  insuranceDate      String?  @map("insurance_date")
  filePath           String?  @map("file_path")
  insuranceFilePath  String?  @map("insurance_file_path")
  sealedFilePath     String?  @map("sealed_file_path")
  archiveStatus      String   @default("not_started") @map("archive_status")
  sealedUploadedBy   String?  @map("sealed_uploaded_by")
  sealedUploadedAt   DateTime? @map("sealed_uploaded_at")
  sealedVerificationStatus String? @map("sealed_verification_status")
  sealedVerificationReport String? @map("sealed_verification_report")
  approvalSubmittedAt DateTime? @map("approval_submitted_at")
  approvalApprovedAt DateTime? @map("approval_approved_at")
  isAuditDraft       Boolean  @default(false) @map("is_audit_draft")
  followDept         String?  @map("follow_dept")
  costDept           String?  @map("cost_dept")
  costCode           String?  @map("cost_code")
  createdAt          DateTime @default(now()) @map("created_at")
  userId             String?  @map("user_id")

  user      User?           @relation(fields: [userId], references: [id])
  uploads   Upload[]
  audits    AuditRecord[]
  reminders Reminder[]
  approvals ApprovalRecord[] @relation("ContractApprovals")

  @@map("contracts")
}

model Upload {
  id           String   @id @default(uuid())
  contractId   String?  @map("contract_id")
  filename     String
  originalName String   @map("original_name")
  size         Int
  mimeType     String   @map("mime_type")
  uploadedAt   DateTime @default(now()) @map("uploaded_at")

  contract Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  @@map("uploads")
}

model AuditRecord {
  id                      String   @id @default(uuid())
  contractId              String   @map("contract_id")
  riskScore               Int      @default(0) @map("risk_score")
  issuesCount             Int      @default(0) @map("issues_count")
  status                  String   @default("pending")
  analysis                String?
  suggestions             String?
  summary                 String   @default("")
  templateId              String?  @map("template_id")
  templateVersion         Int?     @map("template_version")
  templateContentSnapshot String?  @map("template_content_snapshot")
  contractType            String?  @map("contract_type")
  extractedFields         String   @default("{}") @map("extracted_fields")
  ruleIssues              String   @default("[]") @map("rule_issues")
  aiIssues                String   @default("[]") @map("ai_issues")
  reviewedIssues          String   @default("[]") @map("reviewed_issues")
  needHumanReviewCount    Int      @default(0) @map("need_human_review_count")
  auditVersion            String   @default("structured-v1") @map("audit_version")
  createdAt               DateTime @default(now()) @map("created_at")
  reviewedBy              String?  @map("reviewed_by")

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  reviewer User?    @relation(fields: [reviewedBy], references: [id])

  @@map("audit_records")
}

model Reminder {
  id            String   @id @default(uuid())
  contractId    String   @map("contract_id")
  contractName  String   @map("contract_name")
  daysRemaining Int      @map("days_remaining")
  type          String
  priority      String   @default("medium")
  description   String?
  createdAt     DateTime @default(now()) @map("created_at")

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@map("reminders")
}

model AuditTemplate {
  id             String   @id @default(uuid())
  contractType   String   @unique @map("contract_type")
  name           String
  content        String
  summaryContent String   @default("") @map("summary_content")
  version        Int      @default(1)
  updatedBy      String?  @map("updated_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  updater User? @relation(fields: [updatedBy], references: [id])

  @@map("audit_templates")
}

model StorageConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("storage_config")
}

model AiConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@map("ai_config")
}

model Project {
  id                    String    @id @default(uuid())
  name                  String
  description           String?
  status                String    @default("active")
  department            String?
  priority              String    @default("medium")
  type                  String?
  progress              Int       @default(0)
  ownerId               String?   @map("owner_id")
  targetName            String?   @map("target_name")
  targetDate            DateTime? @map("target_date")
  countdownMode         Boolean   @default(false) @map("countdown_mode")
  countdownLabel        String?   @map("countdown_label")
  completionNote        String?   @map("completion_note")
  completionSubmittedAt DateTime? @map("completion_submitted_at")
  completionApprovedAt  DateTime? @map("completion_approved_at")
  startDate             DateTime? @map("start_date")
  endDate               DateTime? @map("end_date")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  owner      User? @relation("ProjectOwner", fields: [ownerId], references: [id])
  tasks      Task[]
  members    ProjectMember[]
  files      ProjectFile[]
  changeLogs TaskChangeLog[]

  @@map("projects")
}

model ProjectFile {
  id           String   @id @default(uuid())
  projectId    String   @map("project_id")
  filename     String
  originalName String   @map("original_name")
  size         Int
  mimeType     String   @map("mime_type")
  fileType     String   @default("support") @map("file_type")
  uploadedBy   String?  @map("uploaded_by")
  uploadedAt   DateTime @default(now()) @map("uploaded_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader User?  @relation(fields: [uploadedBy], references: [id])

  @@map("project_files")
}

model ProjectMember {
  id        String @id @default(uuid())
  projectId String @map("project_id")
  userId    String @map("user_id")
  role      String @default("member")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
  @@map("project_members")
}

model Task {
  id          String    @id @default(uuid())
  projectId   String    @map("project_id")
  parentId    String?   @map("parent_id")
  title       String
  description String?
  status      String    @default("todo")
  priority    String    @default("medium")
  assigneeId  String?   @map("assignee_id")
  startDate   DateTime? @map("start_date")
  dueDate     DateTime? @map("due_date")
  completedAt DateTime? @map("completed_at")
  completionNote String? @map("completion_note")
  completionSubmittedAt DateTime? @map("completion_submitted_at")
  completionApprovedAt DateTime? @map("completion_approved_at")
  progress    Int       @default(0)
  relativeToTarget Boolean @default(false) @map("relative_to_target")
  startOffsetDays Int? @map("start_offset_days")
  dueOffsetDays Int? @map("due_offset_days")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent          Task?            @relation("TaskSubtasks", fields: [parentId], references: [id])
  subtasks        Task[]           @relation("TaskSubtasks")
  assignee        User?            @relation(fields: [assigneeId], references: [id])
  comments        TaskComment[]
  files           TaskFile[]
  changeLogs      TaskChangeLog[]
  dependencies    TaskDependency[] @relation("TaskDependents")
  dependents      TaskDependency[] @relation("TaskDependencies")
  progressUpdates ProgressUpdate[]

  @@map("tasks")
}

model TaskFile {
  id           String   @id @default(uuid())
  taskId       String   @map("task_id")
  filename     String
  originalName String   @map("original_name")
  size         Int
  mimeType     String   @map("mime_type")
  fileType     String   @default("completion") @map("file_type")
  uploadedBy   String?  @map("uploaded_by")
  uploadedAt   DateTime @default(now()) @map("uploaded_at")

  task     Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploader User? @relation(fields: [uploadedBy], references: [id])

  @@map("task_files")
}

model TaskDependency {
  id              String @id @default(uuid())
  taskId          String @map("task_id")
  dependsOnTaskId String @map("depends_on_task_id")

  task      Task @relation("TaskDependents", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task @relation("TaskDependencies", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
  @@map("task_dependencies")
}

model TaskComment {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  userId    String   @map("user_id")
  content   String
  mentions  String   @default("[]")
  createdAt DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@map("task_comments")
}

model TaskChangeLog {
  id        String   @id @default(uuid())
  projectId String?  @map("project_id")
  taskId    String?  @map("task_id")
  userId    String   @map("user_id")
  action    String
  fieldName String?  @map("field_name")
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now()) @map("created_at")

  task    Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id])

  @@map("task_change_logs")
}

model ProgressUpdate {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  userId    String   @map("user_id")
  progress  Int      @default(0)
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@map("progress_updates")
}

model ProcurementRequest {
  id              String   @id @default(uuid())
  title           String
  description     String?
  category        String?
  amount          Float    @default(0)
  quantity        Int      @default(1)
  unit            String?
  requesterId     String   @map("requester_id")
  department      String?
  status          String   @default("draft")
  urgency         String   @default("normal")
  reason          String?
  supplierId      String?  @map("supplier_id")
  purchaseOrderId String?  @map("purchase_order_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  requester     User             @relation(fields: [requesterId], references: [id])
  supplier      Supplier?        @relation(fields: [supplierId], references: [id])
  approvals     ApprovalRecord[] @relation("ProcurementApprovals")
  purchaseOrder PurchaseOrder?   @relation("PurchaseOrderRequests", fields: [purchaseOrderId], references: [id])

  @@map("procurement_requests")
}

model Supplier {
  id        String   @id @default(uuid())
  name      String
  code      String?  @unique
  contact   String?
  phone     String?
  email     String?
  address   String?
  category  String?
  status    String   @default("active")
  remark    String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  procurementRequests ProcurementRequest[]
  purchaseOrders      PurchaseOrder[]

  @@map("suppliers")
}

model PurchaseOrder {
  id           String    @id @default(uuid())
  orderNo      String    @unique @map("order_no")
  supplierId   String    @map("supplier_id")
  totalAmount  Float     @default(0) @map("total_amount")
  status       String    @default("pending")
  orderedDate  DateTime? @map("ordered_date")
  receivedDate DateTime? @map("received_date")
  remark       String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  supplier            Supplier             @relation(fields: [supplierId], references: [id])
  procurementRequests ProcurementRequest[] @relation("PurchaseOrderRequests")

  @@map("purchase_orders")
}

model AssetSetting {
  id          String   @id @default(uuid())
  category    String
  code        String
  name        String
  description String?
  status      String   @default("active")
  sortOrder   Int      @default(0) @map("sort_order")
  remark      String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([category, code])
  @@map("asset_settings")
}

model AssetItem {
  id        String   @id @default(uuid())
  itemNo    String   @unique @map("item_no")
  itemName  String   @map("item_name")
  itemDec   String?  @map("item_dec")
  itemBrand String?  @map("item_brand")
  itemUnit  String?  @map("item_unit")
  bsstype   String?
  assettype String?
  status    String   @default("active")
  remark    String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  prices       AssetPrice[]
  requestItems AssetPurchaseRequestItem[]
  orderItems   AssetPurchaseOrderItem[]
  receivingItems AssetReceivingItem[]
  inventoryBalances InventoryBalance[]
  inventoryTransactions InventoryTransaction[]

  @@map("asset_items")
}

model AssetSupplier {
  id              String   @id @default(uuid())
  suppliersId     String   @unique @map("suppliers_id")
  suppliersNameCn String   @map("suppliers_name_cn")
  suppliersNameEn String?  @map("suppliers_name_en")
  suppliersCity   String?  @map("suppliers_city")
  contactPerson   String?  @map("contact_person")
  contactTitle    String?  @map("contact_title")
  contactNumber   String?  @map("contact_number")
  email           String?
  invoiceName     String?  @map("invoice_name")
  taxId           String?  @map("tax_id")
  invoiceAdd      String?  @map("invoice_add")
  bank            String?
  bankAccountNo   String?  @map("bank_account_no")
  status          String   @default("active")
  remark          String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  prices       AssetPrice[]
  requestItems AssetPurchaseRequestItem[]
  purchaseOrders AssetPurchaseOrder[]

  @@map("asset_suppliers")
}

model AssetPrice {
  id             String   @id @default(uuid())
  itemId         String   @map("item_id")
  supplierId     String   @map("supplier_id")
  unitPrice      Float    @default(0) @map("unit_price")
  taxRate        Float    @default(0) @map("tax_rate")
  effectiveDate  DateTime? @map("effective_date")
  expiryDate     DateTime? @map("expiry_date")
  status         String   @default("draft")
  remark         String?
  createdBy      String?  @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  item     AssetItem     @relation(fields: [itemId], references: [id])
  supplier AssetSupplier @relation(fields: [supplierId], references: [id])

  @@map("asset_prices")
}

model AssetPurchaseRequest {
  id          String   @id @default(uuid())
  requestNo   String   @unique @map("request_no")
  title       String
  department  String?
  costCenter  String?  @map("cost_center")
  status      String   @default("draft")
  reason      String?
  requesterId String   @map("requester_id")
  totalAmount Float    @default(0) @map("total_amount")
  submitNote  String?  @map("submit_note")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  requester User                       @relation(fields: [requesterId], references: [id])
  items     AssetPurchaseRequestItem[]
  orders    AssetPurchaseOrder[]

  @@map("asset_purchase_requests")
}

model AssetPurchaseRequestItem {
  id          String @id @default(uuid())
  requestId   String @map("request_id")
  itemId      String @map("item_id")
  supplierId  String? @map("supplier_id")
  quantity    Float  @default(1)
  unit        String?
  unitPrice   Float  @default(0) @map("unit_price")
  taxRate     Float  @default(0) @map("tax_rate")
  amount      Float  @default(0)
  remark      String?

  request  AssetPurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  item     AssetItem             @relation(fields: [itemId], references: [id])
  supplier AssetSupplier?        @relation(fields: [supplierId], references: [id])

  @@map("asset_purchase_request_items")
}

model AssetPurchaseOrder {
  id          String   @id @default(uuid())
  orderNo     String   @unique @map("order_no")
  requestId   String?  @map("request_id")
  supplierId  String   @map("supplier_id")
  status      String   @default("pending")
  totalAmount Float    @default(0) @map("total_amount")
  orderedDate DateTime? @map("ordered_date")
  remark      String?
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  request  AssetPurchaseRequest? @relation(fields: [requestId], references: [id])
  supplier AssetSupplier         @relation(fields: [supplierId], references: [id])
  items    AssetPurchaseOrderItem[]
  receipts AssetReceivingRecord[]

  @@map("asset_purchase_orders")
}

model AssetPurchaseOrderItem {
  id         String @id @default(uuid())
  orderId    String @map("order_id")
  itemId     String @map("item_id")
  quantity   Float  @default(1)
  receivedQty Float @default(0) @map("received_qty")
  unit       String?
  unitPrice  Float  @default(0) @map("unit_price")
  taxRate    Float  @default(0) @map("tax_rate")
  amount     Float  @default(0)
  remark     String?

  order AssetPurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item  AssetItem          @relation(fields: [itemId], references: [id])
  receivingItems AssetReceivingItem[]

  @@map("asset_purchase_order_items")
}

model AssetReceivingRecord {
  id          String   @id @default(uuid())
  receiptNo   String   @unique @map("receipt_no")
  orderId     String?  @map("order_id")
  warehouse   String?
  status      String   @default("draft")
  receivedBy  String?  @map("received_by")
  receivedAt  DateTime @default(now()) @map("received_at")
  submitNote  String?  @map("submit_note")
  remark      String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  order AssetPurchaseOrder? @relation(fields: [orderId], references: [id])
  items AssetReceivingItem[]

  @@map("asset_receiving_records")
}

model AssetReceivingItem {
  id        String @id @default(uuid())
  receiptId String @map("receipt_id")
  orderItemId String? @map("order_item_id")
  itemId    String @map("item_id")
  quantity  Float  @default(1)
  unit      String?
  unitPrice Float  @default(0) @map("unit_price")
  amount    Float  @default(0)
  remark    String?

  receipt   AssetReceivingRecord @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  orderItem AssetPurchaseOrderItem? @relation(fields: [orderItemId], references: [id])
  item      AssetItem @relation(fields: [itemId], references: [id])

  @@map("asset_receiving_items")
}

model InventoryBalance {
  id        String   @id @default(uuid())
  itemId    String   @map("item_id")
  warehouse String
  quantity  Float    @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  item AssetItem @relation(fields: [itemId], references: [id])

  @@unique([itemId, warehouse])
  @@map("inventory_balances")
}

model InventoryTransaction {
  id            String   @id @default(uuid())
  itemId        String   @map("item_id")
  warehouse     String
  operationType String   @map("operation_type")
  quantity      Float
  unit          String?
  refType       String?  @map("ref_type")
  refId         String?  @map("ref_id")
  remark        String?
  createdBy     String?  @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  item AssetItem @relation(fields: [itemId], references: [id])

  @@map("inventory_transactions")
}

model AssetChangeRequest {
  id          String   @id @default(uuid())
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  action      String
  payload     Json
  status      String   @default("pending")
  submitNote  String?  @map("submit_note")
  requestedBy String   @map("requested_by")
  approvedAt  DateTime? @map("approved_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  requester User @relation(fields: [requestedBy], references: [id])

  @@map("asset_change_requests")
}

model ApprovalFlow {
  id          String   @id @default(uuid())
  name        String
  module      String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  steps ApprovalFlowStep[]

  @@map("approval_flows")
}

model ApprovalFlowStep {
  id         String  @id @default(uuid())
  flowId     String  @map("flow_id")
  stepOrder  Int     @map("step_order")
  roleName   String  @map("role_name")
  actionType String  @default("approve")
  required   Boolean @default(true)

  flow ApprovalFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@map("approval_flow_steps")
}

model ApprovalRecord {
  id          String   @id @default(uuid())
  flowId      String?  @map("flow_id")
  stepId      String?  @map("step_id")
  requestId   String   @map("request_id")
  requestType String   @map("request_type")
  approverId  String   @map("approver_id")
  status      String   @default("pending")
  comment     String?
  auditRecordId String? @map("audit_record_id")
  auditSnapshot String? @map("audit_snapshot")
  submitNote  String? @map("submit_note")
  riskScore   Int? @map("risk_score")
  criticalIssueCount Int? @map("critical_issue_count")
  createdAt   DateTime @default(now()) @map("created_at")

  approver           User                @relation(fields: [approverId], references: [id])
  procurementRequest ProcurementRequest? @relation("ProcurementApprovals", fields: [requestId], references: [id], map: "fk_approval_procurement")
  contract           Contract?           @relation("ContractApprovals", fields: [requestId], references: [id], map: "fk_approval_contract")

  @@map("approval_records")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String
  title     String
  content   String?
  module    String?
  refId     String?  @map("ref_id")
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model NotificationPreference {
  id           String  @id @default(uuid())
  userId       String  @map("user_id")
  type         String
  emailEnabled Boolean @default(true) @map("email_enabled")
  inAppEnabled Boolean @default(true) @map("in_app_enabled")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, type])
  @@map("notification_preferences")
}

model CustomRole {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("custom_roles")
}

model UserRole {
  id     String @id @default(uuid())
  userId String @map("user_id")
  roleId String @map("role_id")

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role CustomRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model Permission {
  id          String  @id @default(uuid())
  module      String
  action      String
  description String?

  rolePermissions RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       CustomRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}
